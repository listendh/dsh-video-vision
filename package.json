{
  "name": "dsh-video-vision",
  "version": "0.2.3",
  "description": "Give DeepSeek Harness eyes for video: adds a read_video tool that samples frames from a video file and hands them to the model as images, places frames on the biggest picture changes, and adds subtitle text and container metadata.",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "deepseek",
    "harness",
    "video",
    "vision",
    "multimodal",
    "ffmpeg",
    "read_video"
  ],
  "license": "MIT",
  "author": "listendh",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/verify.mjs",
    "test:strict": "node test/verify.mjs --strict"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaaaa-1111111/dsh-video-vision.git"
  },
  "bugs": {
    "url": "https://github.com/aaaaa-1111111/dsh-video-vision/issues"
  },
  "homepage": "https://github.com/aaaaa-1111111/dsh-video-vision#readme"
}
